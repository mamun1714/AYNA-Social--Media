
package com.mamun.ayna;

import com.google.firebase.auth.FirebaseAuth;
import com.google.firebase.auth.FirebaseUser;
import com.google.firebase.firestore.DocumentReference;
import com.google.firebase.firestore.DocumentSnapshot;
import com.google.firebase.firestore.FirebaseFirestore;
import com.google.firebase.firestore.ListenerRegistration;
import com.google.firebase.firestore.Query;

import java.util.ArrayList;
import java.util.Date;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class NotificationManager {

    private final FirebaseFirestore db;
    private final FirebaseAuth auth;

    public NotificationManager() {
        db = FirebaseFirestore.getInstance();
        auth = FirebaseAuth.getInstance();
    }

    public interface ActionCallback {
        void onSuccess();
        void onError(String error);
    }

    public interface NotificationCallback {
        void onLoaded(List<Map<String, Object>> notifications);
        void onError(String error);
    }

    public interface CountCallback {
        void onCount(int count);
        void onError(String error);
    }

    private String getCurrentUid() {
        FirebaseUser user = auth.getCurrentUser();
        return user == null ? null : user.getUid();
    }

    private boolean isValid(String value) {
        return value != null && !value.trim().isEmpty();
    }

    // Create notification for another user
    public void createNotification(
            String receiverId,
            String type,
            String title,
            String message,
            String senderId,
            String relatedId,
            ActionCallback callback) {

        if (!isValid(receiverId) || !isValid(type)) {
            callback.onError("Invalid notification information");
            return;
        }

        String currentUid = getCurrentUid();

        if (!isValid(currentUid)) {
            callback.onError("User is not logged in");
            return;
        }

        if (currentUid.equals(receiverId)) {
            callback.onSuccess();
            return;
        }

        Map<String, Object> data = new HashMap<>();
        data.put("receiverId", receiverId);
        data.put("senderId", isValid(senderId) ? senderId : currentUid);
        data.put("type", type);
        data.put("title", title == null ? "" : title);
        data.put("message", message == null ? "" : message);
        data.put("relatedId", relatedId == null ? "" : relatedId);
        data.put("isRead", false);
        data.put("createdAt", new Date());

        db.collection("users")
                .document(receiverId)
                .collection("notifications")
                .add(data)
                .addOnSuccessListener(documentReference ->
                        callback.onSuccess())
                .addOnFailureListener(e ->
                        callback.onError(e.getMessage()));
    }

    // Listen to current user's notifications
    public ListenerRegistration listenNotifications(
            NotificationCallback callback) {

        String uid = getCurrentUid();

        if (!isValid(uid)) {
            callback.onError("User is not logged in");
            return null;
        }

        return db.collection("users")
                .document(uid)
                .collection("notifications")
                .orderBy("createdAt", Query.Direction.DESCENDING)
                .addSnapshotListener((snapshot, error) -> {

                    if (error != null) {
                        callback.onError(error.getMessage());
                        return;
                    }

                    List<Map<String, Object>> result = new ArrayList<>();

                    if (snapshot != null) {
                        for (DocumentSnapshot document : snapshot.getDocuments()) {
                            Map<String, Object> item =
                                    new HashMap<>(document.getData());

                            item.put("notificationId", document.getId());
                            result.add(item);
                        }
                    }

                    callback.onLoaded(result);
                });
    }

    // Mark one notification as read
    public void markAsRead(
            String notificationId,
            ActionCallback callback) {

        String uid = getCurrentUid();

        if (!isValid(uid) || !isValid(notificationId)) {
            callback.onError("Invalid user or notification ID");
            return;
        }

        db.collection("users")
                .document(uid)
                .collection("notifications")
                .document(notificationId)
                .update("isRead", true)
                .addOnSuccessListener(unused -> callback.onSuccess())
                .addOnFailureListener(e ->
                        callback.onError(e.getMessage()));
    }

    // Mark all notifications as read
    public void markAllAsRead(ActionCallback callback) {

        String uid = getCurrentUid();

        if (!isValid(uid)) {
            callback.onError("User is not logged in");
            return;
        }

        db.collection("users")
                .document(uid)
                .collection("notifications")
                .whereEqualTo("isRead", false)
                .get()
                .addOnSuccessListener(snapshot -> {

                    if (snapshot.isEmpty()) {
                        callback.onSuccess();
                        return;
                    }

                    com.google.firebase.firestore.WriteBatch batch =
                            db.batch();

                    for (DocumentSnapshot document : snapshot.getDocuments()) {
                        batch.update(document.getReference(), "isRead", true);
                    }

                    batch.commit()
                            .addOnSuccessListener(unused -> callback.onSuccess())
                            .addOnFailureListener(e ->
                                    callback.onError(e.getMessage()));
                })
                .addOnFailureListener(e ->
                        callback.onError(e.getMessage()));
    }

    // Get unread notification count
    public void getUnreadCount(CountCallback callback) {

        String uid = getCurrentUid();

        if (!isValid(uid)) {
            callback.onError("User is not logged in");
            return;
        }

        db.collection("users")
                .document(uid)
                .collection("notifications")
                .whereEqualTo("isRead", false)
                .get()
                .addOnSuccessListener(snapshot ->
                        callback.onCount(snapshot.size()))
                .addOnFailureListener(e ->
                        callback.onError(e.getMessage()));
    }

    // Delete one notification
    public void deleteNotification(
            String notificationId,
            ActionCallback callback) {

        String uid = getCurrentUid();

        if (!isValid(uid) || !isValid(notificationId)) {
            callback.onError("Invalid user or notification ID");
            return;
        }

        db.collection("users")
                .document(uid)
                .collection("notifications")
                .document(notificationId)
                .delete()
                .addOnSuccessListener(unused -> callback.onSuccess())
                .addOnFailureListener(e ->
                        callback.onError(e.getMessage()));
    }

    // Stop live notification listener
    public void removeListener(ListenerRegistration listener) {
        if (listener != null) {
            listener.remove();
        }
    }
}
