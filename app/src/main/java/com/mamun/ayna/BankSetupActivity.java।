
package com.mamun.ayna;

import android.app.Activity;
import android.os.Bundle;
import android.graphics.Color;
import android.graphics.Typeface;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import android.widget.Toast;

import com.google.firebase.auth.FirebaseAuth;
import com.google.firebase.firestore.DocumentReference;
import com.google.firebase.firestore.FirebaseFirestore;
import com.google.firebase.firestore.FieldValue;
import com.google.firebase.firestore.SetOptions;

import java.util.HashMap;
import java.util.Map;

public class BankSetupActivity extends Activity {

    private FirebaseAuth auth;
    private FirebaseFirestore db;

    private EditText bankName;
    private EditText accountName;
    private EditText accountNumber;
    private EditText swiftCode;
    private EditText routingCode;
    private EditText branchName;

    private TextView verificationStatus;
    private Button saveButton;
    private Button refreshButton;

    private final int BLUE = Color.rgb(23, 105, 170);
    private final int DARK = Color.rgb(35, 45, 60);
    private final int GRAY = Color.rgb(105, 115, 130);

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        auth = FirebaseAuth.getInstance();
        db = FirebaseFirestore.getInstance();

        if (auth.getCurrentUser() == null) {
            Toast.makeText(this,
                    "Please login first",
                    Toast.LENGTH_LONG).show();
            finish();
            return;
        }

        createScreen();
        loadBankDetails();
    }

    private void createScreen() {

        ScrollView scroll = new ScrollView(this);
        scroll.setFillViewport(true);
        scroll.setBackgroundColor(Color.rgb(245, 247, 251));

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(dp(20), dp(20), dp(20), dp(25));

        scroll.addView(root);

        TextView title = new TextView(this);
        title.setText("AYNA Bank Account");
        title.setTextSize(24);
        title.setTextColor(BLUE);
        title.setTypeface(null, Typeface.BOLD);
        root.addView(title);

        TextView description = new TextView(this);
        description.setText(
                "Manage your registered bank account and check " +
                "its verification status."
        );
        description.setTextSize(14);
        description.setTextColor(GRAY);
        description.setPadding(0, dp(8), 0, dp(18));
        root.addView(description);

        addLabel(root, "Bank Name");
        bankName = addInput(root, "Bank name");

        addLabel(root, "Account Holder Name");
        accountName = addInput(root, "Account holder name");

        addLabel(root, "Account Number / IBAN");
        accountNumber = addInput(root, "Account number or IBAN");

        addLabel(root, "SWIFT / BIC Code");
        swiftCode = addInput(root, "SWIFT code");

        addLabel(root, "Routing Number / IFSC");
        routingCode = addInput(root, "Routing or IFSC code");

        addLabel(root, "Branch Name");
        branchName = addInput(root, "Branch name");

        verificationStatus = new TextView(this);
        verificationStatus.setText(
                "Verification Status: Loading..."
        );
        verificationStatus.setTextSize(15);
        verificationStatus.setTextColor(DARK);
        verificationStatus.setTypeface(null, Typeface.BOLD);
        verificationStatus.setPadding(0, dp(18), 0, dp(15));
        root.addView(verificationStatus);

        saveButton = new Button(this);
        saveButton.setText("Update Bank Details");
        saveButton.setTextColor(Color.WHITE);
        saveButton.setBackgroundTintList(
                android.content.res.ColorStateList.valueOf(BLUE)
        );
        root.addView(saveButton);

        refreshButton = new Button(this);
        refreshButton.setText("Refresh Verification Status");
        root.addView(refreshButton);

        saveButton.setOnClickListener(v -> saveBankDetails());

        refreshButton.setOnClickListener(v -> loadBankDetails());

        setContentView(scroll);
    }

    private void addLabel(LinearLayout root, String text) {

        TextView label = new TextView(this);
        label.setText(text);
        label.setTextSize(14);
        label.setTextColor(DARK);
        label.setTypeface(null, Typeface.BOLD);

        LinearLayout.LayoutParams params =
                new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        LinearLayout.LayoutParams.WRAP_CONTENT
                );

        params.setMargins(0, dp(10), 0, dp(5));
        root.addView(label, params);
    }

    private EditText addInput(
            LinearLayout root,
            String hint
    ) {

        EditText input = new EditText(this);
        input.setHint(hint);
        input.setTextSize(15);
        input.setSingleLine(true);
        input.setPadding(dp(12), dp(10), dp(12), dp(10));
        input.setBackgroundColor(Color.WHITE);

        root.addView(input,
                new LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        dp(52)
                ));

        return input;
    }

    private DocumentReference getPayoutReference() {

        String uid = auth.getCurrentUser().getUid();

        return db.collection("users")
                .document(uid)
                .collection("private")
                .document("payout");
    }

    private void loadBankDetails() {

        if (auth.getCurrentUser() == null) {
            return;
        }

        refreshButton.setEnabled(false);

        getPayoutReference().get()
                .addOnSuccessListener(document -> {

                    refreshButton.setEnabled(true);

                    if (!document.exists()) {
                        verificationStatus.setText(
                                "No bank account has been submitted yet."
                        );
                        return;
                    }

                    setField(bankName,
                            document.getString("bankName"));

                    setField(accountName,
                            document.getString("accountName"));

                    setField(accountNumber,
                            document.getString("accountNumber"));

                    setField(swiftCode,
                            document.getString("swiftCode"));

                    setField(routingCode,
                            document.getString("routingCode"));

                    setField(branchName,
                            document.getString("branchName"));

                    String status =
                            document.getString("verificationStatus");

                    if (status == null || status.trim().isEmpty()) {
                        status = "PENDING";
                    }

                    verificationStatus.setText(
                            "Verification Status: " + status
                    );
                })
                .addOnFailureListener(error -> {

                    refreshButton.setEnabled(true);

                    showMessage(
                            "Could not load bank details: " +
                            error.getMessage()
                    );
                });
    }

    private void saveBankDetails() {

        if (auth.getCurrentUser() == null) {
            showMessage("Please login first");
            return;
        }

        String bank = getValue(bankName);
        String holder = getValue(accountName);
        String number = getValue(accountNumber);

        if (bank.isEmpty()) {
            bankName.setError("Enter bank name");
            return;
        }

        if (holder.isEmpty()) {
            accountName.setError("Enter account holder name");
            return;
        }

        if (number.isEmpty()) {
            accountNumber.setError("Enter account number");
            return;
        }

        saveButton.setEnabled(false);
        saveButton.setText("Updating...");

        Map<String, Object> updates = new HashMap<>();

        updates.put("bankName", bank);
        updates.put("accountName", holder);
        updates.put("accountNumber", number);
        updates.put("swiftCode", getValue(swiftCode));
        updates.put("routingCode", getValue(routingCode));
        updates.put("branchName", getValue(branchName));

        // Any changed bank information requires fresh verification.
        updates.put("verificationStatus", "PENDING");
        updates.put("payoutStatus", "NOT_ACTIVE");
        updates.put("updatedAt", FieldValue.serverTimestamp());

        getPayoutReference()
                .set(updates, SetOptions.merge())
                .addOnSuccessListener(unused -> {

                    saveButton.setEnabled(true);
                    saveButton.setText("Update Bank Details");

                    verificationStatus.setText(
                            "Verification Status: PENDING"
                    );

                    showMessage(
                            "Bank details updated. Verification is pending."
                    );
                })
                .addOnFailureListener(error -> {

                    saveButton.setEnabled(true);
                    saveButton.setText("Update Bank Details");

                    showMessage(
                            "Update failed: " + error.getMessage()
                    );
                });
    }

    private void setField(EditText field, String value) {
        if (value != null) {
            field.setText(value);
        }
    }

    private String getValue(EditText field) {
        return field.getText().toString().trim();
    }

    private int dp(int value) {
        return (int) (
                value * getResources()
                        .getDisplayMetrics().density
        );
    }

    private void showMessage(String message) {
        Toast.makeText(
                this,
                message,
                Toast.LENGTH_LONG
        ).show();
    }
}
